# Names only. Copy to .env.local and fill in. Never commit values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server routes + local loader only. Never in client code.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_TIMEOUT_MS=8000
# Protects /api/run (Vercel cron)
CRON_SECRET=
# Local only (not on Vercel): folder with the Manyavar CSVs
LOCAL_DATA_DIR=./local-data/manyavar-vch3-data/csv
# 1 = UI reads data/sample/*.json instead of the API
NEXT_PUBLIC_USE_SAMPLE=1
